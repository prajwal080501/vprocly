DATABASE_URL=postgres://vprocly_app:vprocly_app@localhost:55432/vprocly
NATS_URL=nats://localhost:54222
RELAY_BATCH_SIZE=100
RELAY_IDLE_MS=500
S3_ENDPOINT=http://localhost:58333
S3_REGION=us-east-1
S3_ACCESS_KEY=vprocly
S3_SECRET_KEY=vprocly-secret
S3_BUCKET_DOCUMENTS=vprocly-documents
S3_BUCKET_QUARANTINE=vprocly-quarantine
CLAMAV_HOST=localhost
CLAMAV_PORT=53310
TEMPORAL_ADDRESS=localhost:57233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=vprocly-platform
UPLOAD_DEADLINE_SECONDS=3600
# Local dev/test default to Mailpit (no auth). For a real deployment, point these at a real provider --
# e.g. Namecheap Private Email: SMTP_HOST=mail.privateemail.com, SMTP_PORT=587, plus SMTP_USER/SMTP_PASS.
# Never commit real credentials -- put them in this file (gitignored) or the Helm secret, not here.
EMAIL_DELIVERY_MODE=capture
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=51025
SMTP_HOST=localhost
SMTP_PORT=51025
SMTP_FROM=vProcly RFQ <rfq@vprocly.example>
NOREPLY_SMTP_HOST=localhost
NOREPLY_SMTP_PORT=51025
NOREPLY_SMTP_FROM=vProcly <noreply@vprocly.example>
PUBLIC_WEB_URL=http://localhost:3000
INVITE_TOKEN_TTL_DAYS=14

# AI supplier discovery (supplier-research-agent.ts). Leave both unset to disable -- the worker starts fine
# and sourcing.sourcing_line_unmatched events just queue in JetStream unconsumed until a worker with these
# set is deployed. Never commit real keys -- gitignored file or the Helm secret only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REQUEST_TIMEOUT_MS=60000
GOOGLE_PLACES_API_KEY=
SUPPLIER_RESEARCH_MAX_CANDIDATES=5
# Estimated INR micros based on Gemini 3.8 Flash and Google India list prices as of 2026-10-24.
# Token rates are per 1M tokens; search/details rates are per billable event. Update when prices or the
# Cloud Billing monthly USD/INR conversion change. Free allowances are deliberately excluded.
GEMINI_INPUT_COST_MICROS_PER_MILLION=71301825
GEMINI_OUTPUT_COST_MICROS_PER_MILLION=356509125
GEMINI_SEARCH_COST_MICROS=1330967
GOOGLE_PLACE_DETAILS_COST_MICROS=570415

# Sarvam Voice Agents. Capture mode never places a real call and immediately falls back to the bidding
# email. Live mode calls suppliers that have a phone number and waits for Sarvam's terminal webhook.
VOICE_DELIVERY_MODE=capture
PUBLIC_API_URL=http://localhost:4000
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=4
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=
SARVAM_WEBHOOK_SECRET=
SARVAM_CAMPAIGN_NAME=vprocly-supplier-notification-v4
SARVAM_CAMPAIGN_ATTEMPTS_PER_SECOND=1
SARVAM_CAMPAIGN_MAX_RETRIES=2
SARVAM_CAMPAIGN_RETRY_INTERVAL_MINUTES=15
SARVAM_CAMPAIGN_TIMEZONE=Asia/Kolkata
SARVAM_CAMPAIGN_START_TIME=10:00
SARVAM_CAMPAIGN_END_TIME=18:00
SARVAM_CAMPAIGN_DAYS=Monday,Tuesday,Wednesday,Thursday,Friday,Saturday

# Set by deployment for diagnostics. Optional alert destination receives throttled worker errors.
RELEASE_VERSION=development
OPS_ALERT_WEBHOOK_URL=
