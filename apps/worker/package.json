{
  "name": "@vprocly/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/temporal/bundle.js",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=.env dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "@vprocly/contracts": "workspace:*",
    "@vprocly/db": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "nodemailer": "^10.0.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.24.0",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@vprocly/config": "workspace:*",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
