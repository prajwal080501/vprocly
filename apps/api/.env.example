PORT=4000
DATABASE_URL=postgres://vprocly_app:vprocly_app@localhost:55432/vprocly
OIDC_ISSUER=http://localhost:58080/realms/vprocly
OIDC_AUDIENCE=vprocly-api
S3_ENDPOINT=http://localhost:58333
# Only the excel container needs this override: it fetches the presigned URL itself, and "localhost" from
# inside that container means the container, not the host (see docker-compose.yml's excel service comment).
S3_EXCEL_ENDPOINT=http://host.docker.internal:58333
S3_REGION=us-east-1
S3_ACCESS_KEY=vprocly
S3_SECRET_KEY=vprocly-secret
S3_BUCKET_DOCUMENTS=vprocly-documents
S3_BUCKET_QUARANTINE=vprocly-quarantine
CORS_ORIGIN=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
KEYCLOAK_ADMIN_URL=http://localhost:58080
KEYCLOAK_ADMIN_CLIENT_ID=vprocly-admin-api
KEYCLOAK_ADMIN_CLIENT_SECRET=vprocly-admin-api-secret
KEYCLOAK_TARGET_REALM=vprocly
EXCEL_SERVICE_URL=http://localhost:58001

# Supplier onboarding email OTP. Local defaults point to Mailpit; production reuses the noreply SMTP identity.
NOREPLY_SMTP_HOST=localhost
NOREPLY_SMTP_PORT=51025
NOREPLY_SMTP_USER=
NOREPLY_SMTP_PASS=
NOREPLY_SMTP_FROM=vProcly <noreply@vprocly.example>

# Domain-agnostic category matching (CategoryResolverService). Leave GEMINI_API_KEY unset to disable --
# category resolution then falls back to plain exact-name matching, degraded but never broken. Never commit
# a real key here.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Server-side Google Maps Geocoding API key used to detect checkout country/currency.
GOOGLE_MAPS_API_KEY=

# Must match apps/worker SARVAM_WEBHOOK_SECRET when live supplier calling is enabled.
SARVAM_WEBHOOK_SECRET=

# Razorpay Standard Checkout. Use test-mode keys locally; never expose KEY_SECRET or WEBHOOK_SECRET to web.
# Configure the webhook URL as PUBLIC_API_URL/api/payments/razorpay/webhook and subscribe to payment.captured.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Set by deployment for diagnostics. Optional alert destination receives throttled production errors.
RELEASE_VERSION=development
OPS_ALERT_WEBHOOK_URL=
