{
  "name": "vprocly",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "deploy:aws": "bash scripts/deploy-aws.sh",
    "stack:up": "docker compose -f infra/compose/docker-compose.yml up -d",
    "stack:down": "docker compose -f infra/compose/docker-compose.yml down",
    "db:migrate": "pnpm --filter @vprocly/db migrate",
    "db:generate": "pnpm --filter @vprocly/db generate"
  },
  "devDependencies": {
    "turbo": "^2.11.3"
  }
}
